# ─────────────────────────────────────────────────────────────────────────
# .env.example — hyperliquid-trading-bot konfigürasyon şablonu
#
# Kullanım: bu dosyayı `.env` olarak kopyala, gerçek değerleri doldur:
#   cp .env.example .env
#
# GİZLİLİK: `.env` repoya GİRMEZ (.gitignore). Bu şablon sahte/örnek
# değerlerle doludur — gerçek anahtar asla buraya yazılmaz.
# ─────────────────────────────────────────────────────────────────────────

# ============ ZORUNLU — BORSA BAĞLANTISI ============

# Ortam: "testnet" | "mainnet"
# Bot'un öğrenme dönemi TESTNET'tir: canlı API/NETWORK ile başlamayı
# yapısal olarak reddeder (bkz. engine/src/epoch.rs).
NETWORK=mainnet

# REST + WS uçları (testnet)
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# API wallet (agent) private key — 32 bayt hex, 0x'siz veya 0x'li
# (bu ANAHTAR gizlidir; asla repoya commit EDİLMEZ)
HYPERLIQUID_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Agent (imzalayan) adres — HL testnet'te agent approval ile bağlanır
API_WALLET_ADDRESS=0xYOUR_API_WALLET_ADDRESS

# MASTER (hesap) adresi — clearinghouseState / fills / openOrders sorguları
# bu adres üzerinden yapılır; agent adresinden FARKLIDIR
USER_ADDRESS=0xYOUR_USER_ADDRESS

# ============ MOTOR ============

# Mum aralığı (sn) — stratejiler 1h mumlarla çalışır
ENGINE_INTERVAL=3600
# Motor döngü periyodu (sn) — her turda tam evren taraması + tahsis
ENGINE_CYCLE_SECS=300
# Evren spesifikasyonu (P → tek kaynak):
#   boş veya "all" → tüm aktif evren (~158 coin)
#   "50"           → hacim sırasına göre top 50
#   "BTC,ETH,SOL"  → birebir bu liste (sessiz kırpma yok; uyuşmazlıkta açılış durur)
ENGINE_COINS=all
# İndikatör ısınma penceresi (mum sayısı)
ENGINE_HIST_BARS=4400
# Döngü bütçesi (USD)
ENGINE_BUDGET_USD=500
# Eşzamanlı pozisyon tavanı
ENGINE_TOP_N=1
# Ensemble karar eşiği (|skor| altı nötr)
ENGINE_MIN_SCORE=0.30
# Hesap kaldıracı (cross)
ENGINE_LEVERAGE=5
# Açılışta tüm pozisyonları kapat (1) / pozisyonları devral (0)
# Öğrenme dönemi için 0: restart market'ten düzleşmez, TP/SL emirleri
# borsada durur ve cloid tuzuyla geri yüklenir.
ENGINE_FLATTEN=0
# Keşif şeridi: veri-açlığı olan (n < full_n) stratejiler küçük lotla sınanır
ENGINE_EXPLORE=1
# Kill-switch eşiği: üst üste bu sayıda KARAR-KRİTİK hata → halt
ENGINE_CRIT_THRESHOLD=5

# ============ TRAILING STOP ============

TRAIL_ON=1
# stop mesafesi = k × ATR (giriş stop'u ile aynı — ilk adımda gevşetme yok)
TRAIL_ATR_K=1.5
# minimum taşıma adımı (× ATR) — gürültüde ratchet yasak
TRAIL_MIN_STEP=0.25

# ============ CANLI ÖĞRENME (tracker + ağırlıklar) ============

# n < min_n  → ağırlık DONMUŞ 1.0 (kanıt yetersiz → öldürme yok)
# n ≥ full_n → tam kurallar (win<%35 → 0) + keşif kuyruğu dışı
LEARN_MIN_N=10
LEARN_FULL_N=30

# Tracker persistence (atomik yazım; restart'ta öğrenme korunur)
TRACK_STATE_PATH=config/track_state.json

# Canlı ağırlık dosyası: in = doğrulanmış okuma (`origin:"live"` zorunlu;
# bozuk dosyada AÇILIŞ BAŞARISIZ), out = atomik dump (tmp+rename)
ENSEMBLE_WEIGHTS_IN=config/ensemble_weights_live.json
ENSEMBLE_LIVE_WEIGHTS_OUT=config/ensemble_weights_live.json

# Öğrenilen fiyat tick hassasiyeti (hangi coine kaç hane kabul ediyor)
ENGINE_TICK_CACHE=config/tick_cache.json

# Kapanmış işlem arşivi (append-only; öğrenme metriklerinin kaynağı)
TRADE_EXITS_PATH=config/trade_exits.jsonl

# ============ ÖĞRENME DÖNEMİ (testnet deneyi) ============

# =1 yalnız İLK çalıştırmada: tracker/weights temizler, trade_exits'i
# ARŞİVLER, yeni dönem açar, tüm pozisyonları kapatır.
# Sonraki restartlarda (ENV kalsa bile) state KORUNUR — her restart'ta
# silmek DEĞİLDİR.
# HARD RESET İLK AÇILIŞI: 1 = temiz deney başlangıcı (wipe + flatten)
# İLK BAŞARILI AÇILIŞTAN SONRA bunu TEKRAR BOŞ bırakılır — normal restart
# state'i KORUMAK zorunda (bkz. bölüm 9: FRESH START = yalnız bu deneyin
# başlangıç reseti; normal restart = state korunur).
TESTNET_FRESH_START=
# Dönem kaydı + kalıcı işlem sayacı (100 GERÇEK kapanmış işlem →
# ready_for_live; otomatik canlı işlem YOK)
LEARNING_EPOCH_PATH=config/learning_epoch.json

# Kalıcı risk hafızası: peak_equity + halted — restart drawdown hafızasını
# sıfırlamaz (100→80'de halt; restart'ta 80 yeni peak SANILMAZ).
# FRESH_START bu dosyayı da siler (yeni deney = yeni risk hafızası).
RISK_STATE_PATH=config/risk_state.json

# ============ TEK MALİYET MODELİ (EV kapısı + yürütme bandı) ============

# taker fee (bps) — Hyperliquid taker %0.045
EV_TAKER_FEE_BPS=4.5
# taban kayma (bps) — ince defterde gözlenen; EV tabanı = max(EV_MIN_DIST, 3×round-trip)
EV_SLIPPAGE_BPS=5.0
EV_MIN_DIST_BPS=75

# ============ KALICILIK (opsiyonel; boşsa Memory fallback) ============
# NOT: Canlı bot ClickHouse KULLANMAZ — state JSON dosyalarında tutulur
# (config/risk_state.json, config/track_state.json, config/trade_exits.jsonl).
# ClickHouse yalnız backfill_job (tarihsel mum/funding arşivi) içindir.

# Arşiv: hl_trades / hl_candles / hl_funding / hl_ctx (yalnız backfill_job)
CLICKHOUSE_URL=http://localhost:8123
# Sıcak önbellek: mids/ctx (TTL'li) — şu an kullanılmıyor
REDIS_URL=redis://127.0.0.1:6379

# ============ LOG ============

# LOG_LEVEL > RUST_LOG önceliği: trace|debug|info|warn|error
LOG_LEVEL=info
RUST_LOG=info


# ============ EK: ek konfigürasyon ============
API_WALLET_NAME=hyperliquidbot
BOT_NAME=hyperliquid-bot

MAINNET_CONFIRMED=1
ENGINE_MAX_POSITION_USD=300
ENGINE_L2BOOK_TOP_N=10000

 impl Executor {
     /// coin -> (asset id, szDecimals) — cache'li, ağ çağrısı yapmaz (None: yok)
     pub fn cached_asset(&self, coin: &str) -> Option<(u32, u32)> {
         self.assets.get(coin).map(|(a, d, _)| (*a, *d))
     }
